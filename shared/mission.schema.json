{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CODE RED mission import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "missionId",
    "revision",
    "title",
    "description",
    "supportedPlayerCounts",
    "attribution",
    "completion",
    "seats"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "missionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "supportedPlayerCounts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 3,
        "maximum": 6
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team",
        "project",
        "event",
        "sourceRepository",
        "copyright"
      ],
      "properties": {
        "team": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "sourceRepository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "copyright": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "completion": {
      "const": "all-seats-pass-then-host-deploy"
    },
    "seats": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seatId",
          "roleId",
          "roleLabel",
          "challenge"
        ],
        "properties": {
          "seatId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "roleId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "roleLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "challenge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "description",
              "filename",
              "editorLanguage",
              "starterCode",
              "initialTerminal",
              "hint",
              "testPreview",
              "review"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "editorLanguage": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "starterCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "initialTerminal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "hint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "testPreview": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "filename",
                  "language",
                  "content",
                  "executable"
                ],
                "properties": {
                  "filename": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "language": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "executable": {
                    "const": false
                  }
                }
              },
              "review": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "language",
                  "task",
                  "expected",
                  "criteria"
                ],
                "properties": {
                  "mode": {
                    "const": "gemini-review"
                  },
                  "language": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "task": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "expected": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "criteria": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
